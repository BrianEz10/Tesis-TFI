    {
      "parameters": {
        "jsCode": "// Input: $('RD-3 Trigger').first().json.stdout, .read_time\n// (recordá el bug de RD-1: referenciar el nodo trigger por nombre, NO $input.first())\n\nconst stdout = $('RD-3 Trigger').first().json.stdout;\nconst lastRun = new Date($input.first().json.last_run); // desde Get last_run (Postgres)\n\nconst lines = stdout.split('\\n');\nconst regex = /(Failed|Accepted) password for root from (\\d+\\.\\d+\\.\\d+\\.\\d+) port (\\d+)/;\n\n// Necesitamos el timestamp real de cada línea para filtrar por last_run.\n// Igual que en RD-1/RD-2, se asume que el ISODATE ya viene al principio de cada línea\n// (formato Syslog-ng: ${ISODATE} ${HOST} ${PROGRAM} ${MESSAGE})\nconst isoRegex = /^(\\S+)\\s/;\n\nconst events = [];\n\nfor (const line of lines) {\n  const match = line.match(regex);\n  if (!match) continue;\n\n  const isoMatch = line.match(isoRegex);\n  if (!isoMatch) continue;\n\n  const eventTime = new Date(isoMatch[1]);\n  if (eventTime <= lastRun) continue; // ya procesado en una corrida anterior\n\n  events.push({\n    result: match[1],       // 'Failed' o 'Accepted'\n    ip: match[2],\n    port: match[3],\n    timestamp: eventTime.toISOString()\n  });\n}\n\n// Agrupar por IP\nconst byIp = {};\nfor (const ev of events) {\n  if (!byIp[ev.ip]) {\n    byIp[ev.ip] = {\n      src_ip: ev.ip,\n      failed_attempts: 0,\n      accepted: false,\n      first_seen: ev.timestamp,\n      last_seen: ev.timestamp,\n      ports_used: []\n    };\n  }\n  const entry = byIp[ev.ip];\n  if (ev.result === 'Failed') entry.failed_attempts++;\n  if (ev.result === 'Accepted') entry.accepted = true;\n  if (ev.timestamp < entry.first_seen) entry.first_seen = ev.timestamp;\n  if (ev.timestamp > entry.last_seen) entry.last_seen = ev.timestamp;\n  entry.ports_used.push(ev.port);\n}\n\n// Devolver un item por IP detectada (0, 1 o más IPs distintas en la misma corrida)\nreturn Object.values(byIp).map(entry => ({ json: entry }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
