    {
      "parameters": {
        "jsCode": "const rawOutput = $('RD-4 Trigger').first().json.stdout;\nconst lastRun = new Date($('Get last_run').first().json.last_run);\nconst now = new Date();\n\nconst sqliPattern = /(\\bUNION\\b.*\\bSELECT\\b|\\bOR\\b\\s+['\"]?1['\"]?\\s*=\\s*['\"]?1|SLEEP\\s*\\(|information_schema|--\\s|\\bAND\\b\\s+['\"]?1['\"]?\\s*=\\s*['\"]?1|\\bSELECT\\b.*\\bFROM\\b)/i;\n\n// Formato de línea esperado (Syslog-ng): ${ISODATE} dvwa-web apache-access <IP> - - [Apache-date] \"GET ... HTTP/1.1\" ...\nconst lineRegex = /^(\\S+)\\s+dvwa-web\\s+apache-access\\s+(\\d+\\.\\d+\\.\\d+\\.\\d+).*$/;\n\nconst lines = rawOutput.split('\\n').filter(l => l.includes('dvwa-web') && sqliPattern.test(l));\n\nconst ipCounts = {};\nfor (const line of lines) {\n  const match = line.match(lineRegex);\n  if (!match) continue;\n  const [, isodate, ip] = match;\n  const eventTime = new Date(isodate);\n  if (eventTime <= lastRun) continue; // ya procesado en corridas anteriores\n\n  if (!ipCounts[ip]) ipCounts[ip] = { count: 0, queries: [], first_seen: eventTime.toISOString(), last_seen: eventTime.toISOString() };\n  ipCounts[ip].count++;\n  ipCounts[ip].queries.push(line.trim());\n  ipCounts[ip].last_seen = eventTime.toISOString();\n}\n\n// Ventana deslizante de 2 min: filtrar solo IPs cuya última ráfaga cae dentro de esa ventana\nconst results = [];\nfor (const [ip, data] of Object.entries(ipCounts)) {\n  const windowStart = new Date(new Date(data.last_seen).getTime() - 2 * 60 * 1000);\n  const inWindow = data.queries.filter(q => {\n    const m = q.match(lineRegex);\n    return m && new Date(m[1]) >= windowStart;\n  });\n  if (inWindow.length >= 3) {\n    results.push({\n      src_ip: ip,\n      count: inWindow.length,\n      queries: data.queries.slice(-5), // últimas 5 como evidencia, sin saturar el payload\n      first_seen: data.first_seen,\n      last_seen: data.last_seen\n    });\n  }\n}\n\nreturn results.map(r => ({ json: r }));"
      },
