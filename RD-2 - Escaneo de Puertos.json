      "name": "Discord Reincidencia RD-2",
      "webhookId": "cd4e057d-aaa1-448f-b86d-8390915ad20c",
      "credentials": {
        "discordBotApi": {
          "id": "ajvHMeDKIJjgIo9t",
          "name": "Discord Bot account"
        }
      }
