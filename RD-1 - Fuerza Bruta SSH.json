    {
      "parameters": {
        "jsCode": "const lastRun = new Date($('Get last_run').first().json.last_run);\nconst rawOutput = $('RD-1 Trigger').first().json.stdout;\nconst rawLines = rawOutput ? rawOutput.split('\\n').filter(l => l.trim() !== '') : [];\n\nconst attempts = {};\n\nfor (const line of rawLines) {\n  const match = line.match(/^(\\S+)\\s+(\\S+)\\s+sshd.*Failed password.*from (\\d+\\.\\d+\\.\\d+\\.\\d+)/);\n  if (!match) continue;\n\n  const [, isoTimestamp, , ip] = match;\n  const ts = new Date(isoTimestamp);\n  if (ts <= lastRun) continue;\n\n  if (!attempts[ip]) attempts[ip] = [];\n  attempts[ip].push(ts);\n}\n\nconst now = new Date();\nconst windowMs = 5 * 60 * 1000;\nconst results = [];\n\nfor (const ip in attempts) {\n  const recent = attempts[ip].filter(ts => now.getTime() - ts.getTime() <= windowMs);\n  if (recent.length >= 5) {\n    results.push({\n      json: {\n        ip,\n        count: recent.length,\n        first_seen: recent[0].toISOString(),\n        rule_id: 'RD-1'\n      }\n    });\n  }\n}\n\nreturn results;"
      },
