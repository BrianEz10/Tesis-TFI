    {
      "parameters": {
        "jsCode": "const content = $input.first().json.stdout || '';\n\nreturn [{\n  json: {\n    stdout: content,\n    tiene_rd1: content.includes('Failed password'),\n    tiene_rd2: content.includes('PORTSCAN:'),\n    tiene_rd3: /(Failed|Accepted) password for root/.test(content),\n    tiene_rd4: /(\\bUNION\\b.*\\bSELECT\\b|\\bOR\\b\\s+['\"]?1['\"]?\\s*=\\s*['\"]?1|SLEEP\\s*\\(|information_schema|--\\s|\\bAND\\b\\s+['\"]?1['\"]?\\s*=\\s*['\"]?1|\\bSELECT\\b.*\\bFROM\\b)/i.test(content),\n    tiene_rd5: /(\\.\\.\\/|\\.\\.%2f|%2e%2e(%2f|\\/)|\\.{4}\\/\\/)/i.test(content),\n    tiene_rd6: /COMMAND=.*(\\/etc\\/|\\b(useradd|userdel|usermod|passwd)\\b|\\/bin\\/(ba)?sh\\b|\\/usr\\/bin\\/(python|perl)\\b)/i.test(content)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
